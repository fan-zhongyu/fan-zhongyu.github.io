      <section class="page-shell" id="research" aria-labelledby="research-heading">
        <h2 class="section-title" id="research-heading">Selected research</h2>

        <article class="feature-row">
          <figure class="feature-figure">
            <img
              src="{{ '/assets/img/flare-figure.svg' | relative_url }}"
              alt="Abstract graph and matrix diagram for the FLARE project"
              width="520"
              height="520"
            >
          </figure>
          <div class="feature-copy">
            <p class="item-meta">01 · Methodology · Work in progress</p>
            <h3>FLARE</h3>
            <p class="item-lead">Graph-regularized sparse factor learning for GWAS summary statistics with biological annotations.</p>
            <p>
              A matrix factorization framework that uses structured biological information to learn interpretable latent patterns from summary-level
              association data. The project asks how annotation graphs can guide sparsity without overwhelming evidence in the data.
            </p>
            <dl class="method-list">
              <div>
                <dt>Methods</dt>
                <dd>Matrix factorization, graph regularization, structured sparsity</dd>
              </div>
              <div>
                <dt>Computing</dt>
                <dd>R, Rcpp, simulation pipelines</dd>
              </div>
            </dl>
          </div>
        </article>

        <article class="feature-row feature-row-reverse">
          <div class="feature-copy">
            <p class="item-meta">02 · Applied research · Ongoing study</p>
            <h3>Ukraine Longitudinal Study</h3>
            <p class="item-lead">Longitudinal evidence on war exposure and mental health among Ukrainian youth and caregivers.</p>
            <p>
              Working with the Global Mental Health and Flourishing Lab, I analyze repeated observations from youth and caregivers. The analysis
              emphasizes population-averaged interpretation, careful covariate selection, and transparent sensitivity work.
            </p>
            <dl class="method-list">
              <div>
                <dt>Design</dt>
                <dd>Longitudinal youth and caregiver cohort</dd>
              </div>
              <div>
                <dt>Methods</dt>
                <dd>Logistic GEE, LASSO, regression diagnostics</dd>
              </div>
            </dl>
          </div>
          <figure class="feature-figure">
            <img
              src="{{ '/assets/img/ukraine-figure.svg' | relative_url }}"
              alt="Abstract longitudinal trajectories for the Ukraine Longitudinal Study"
              width="520"
              height="520"
              loading="lazy"
            >
          </figure>
        </article>
      </section>

